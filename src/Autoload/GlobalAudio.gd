extends Node

## Music and sound effects. Sounds are generated by tools/sfx/generate_audio.py.
## Usage: GlobalAudio.play_sfx("jump"), GlobalAudio.play_music("level")

const SFX_PATH := "res://assets/audio/sfx/%s.wav"
const MUSIC_PATH := "res://assets/audio/music/%s.ogg"
const SETTINGS_PATH := "user://audio.cfg"

const BUS_MUSIC := "Music"
const BUS_SFX := "SFX"

const SFX_LIST := [
	"jump", "land", "shoot", "empty", "player_hurt", "action", "sheep_hurt",
	"splash", "enemy_hit", "enemy_die", "fireball", "roar",
	"pickup_water", "pickup_life", "pickup_key", "gate", "bike_crash",
	"ui_move", "ui_select", "pause", "tick", "score_tick",
	"level_complete", "game_over",
]

const MUSIC_VOLUME_DB := -6.0
const DUCKED_VOLUME_DB := -22.0
const FADE_TIME := 0.6
# Same sound is not replayed faster than this (ms)
const MIN_REPLAY_DELAY := 40
const POOL_SIZE := 10

signal sound_toggled(enabled: bool)

var music_enabled := true
var sfx_enabled := true

var _streams := {}
var _last_played := {}
var _pool: Array[AudioStreamPlayer] = []
var _pool_index := 0
var _music: AudioStreamPlayer
var _music_name := ""
var _music_tween: Tween


func _ready():
	process_mode = Node.PROCESS_MODE_ALWAYS
	_create_buses()

	for sfx_name in SFX_LIST:
		_streams[sfx_name] = load(SFX_PATH % sfx_name)

	for i in POOL_SIZE:
		var player := AudioStreamPlayer.new()
		player.bus = BUS_SFX
		add_child(player)
		_pool.append(player)

	_music = AudioStreamPlayer.new()
	_music.bus = BUS_MUSIC
	_music.volume_db = MUSIC_VOLUME_DB
	add_child(_music)

	_load_settings()
	get_tree().node_added.connect(_on_node_added)


func _create_buses():
	for bus_name in [BUS_MUSIC, BUS_SFX]:
		if AudioServer.get_bus_index(bus_name) != -1:
			continue
		AudioServer.add_bus()
		var index := AudioServer.bus_count - 1
		AudioServer.set_bus_name(index, bus_name)
		AudioServer.set_bus_send(index, "Master")


func _unhandled_input(event):
	if event is InputEventKey and event.pressed and !event.echo and event.physical_keycode == KEY_M:
		toggle_sound()


# --- effects -----------------------------------------------------------------

func play_sfx(sfx_name: String, pitch_variation := 0.0, volume_db := 0.0, pitch := 1.0) -> void:
	if !sfx_enabled or !_streams.has(sfx_name):
		return
	var now := Time.get_ticks_msec()
	if now - _last_played.get(sfx_name, -1000) < MIN_REPLAY_DELAY:
		return
	_last_played[sfx_name] = now

	var player := _pool[_pool_index]
	_pool_index = (_pool_index + 1) % _pool.size()
	player.stream = _streams[sfx_name]
	player.volume_db = volume_db
	player.pitch_scale = pitch * (1.0 + randf_range(-pitch_variation, pitch_variation))
	player.play()


# --- music -------------------------------------------------------------------

func play_music(music_name: String) -> void:
	if music_name == _music_name and _music.playing:
		_fade_music_to(MUSIC_VOLUME_DB)
		return
	_music_name = music_name
	var stream: AudioStream = load(MUSIC_PATH % music_name)
	if stream is AudioStreamOggVorbis:
		stream.loop = true
	_kill_music_tween()
	_music.stream = stream
	_music.volume_db = -40.0
	if music_enabled:
		_music.play()
	_fade_music_to(MUSIC_VOLUME_DB)


func stop_music(fade := FADE_TIME) -> void:
	_music_name = ""
	_kill_music_tween()
	_music_tween = create_tween()
	_music_tween.tween_property(_music, "volume_db", -40.0, fade)
	_music_tween.tween_callback(_music.stop)


## Plays a short jingle over a stopped music
func play_jingle(jingle_name: String) -> void:
	stop_music(0.2)
	play_sfx(jingle_name)


## Lowers the music, used by the pause screen
func duck_music(ducked: bool) -> void:
	_fade_music_to(DUCKED_VOLUME_DB if ducked else MUSIC_VOLUME_DB, 0.2)


func _fade_music_to(volume_db: float, duration := FADE_TIME) -> void:
	_kill_music_tween()
	_music_tween = create_tween()
	_music_tween.tween_property(_music, "volume_db", volume_db, duration)


func _kill_music_tween() -> void:
	if _music_tween:
		_music_tween.kill()


# --- settings ----------------------------------------------------------------

func is_sound_enabled() -> bool:
	return music_enabled or sfx_enabled


func toggle_sound() -> void:
	set_sound_enabled(!is_sound_enabled())


func set_sound_enabled(enabled: bool) -> void:
	music_enabled = enabled
	sfx_enabled = enabled
	_apply_settings()
	_save_settings()
	sound_toggled.emit(enabled)
	if enabled:
		play_sfx("ui_select")


func _apply_settings() -> void:
	AudioServer.set_bus_mute(AudioServer.get_bus_index(BUS_MUSIC), !music_enabled)
	AudioServer.set_bus_mute(AudioServer.get_bus_index(BUS_SFX), !sfx_enabled)
	if music_enabled and _music_name != "" and !_music.playing:
		_music.play()


func _load_settings() -> void:
	var config := ConfigFile.new()
	if config.load(SETTINGS_PATH) == OK:
		music_enabled = config.get_value("audio", "music", true)
		sfx_enabled = config.get_value("audio", "sfx", true)
	_apply_settings()


func _save_settings() -> void:
	var config := ConfigFile.new()
	config.set_value("audio", "music", music_enabled)
	config.set_value("audio", "sfx", sfx_enabled)
	config.save(SETTINGS_PATH)


# --- automatic ui sounds -----------------------------------------------------

# Every button of the game gets a blip on focus/hover and a confirm on press
func _on_node_added(node: Node) -> void:
	if node is BaseButton and !node.has_meta("no_ui_sound"):
		node.focus_entered.connect(_on_button_focus)
		node.mouse_entered.connect(_on_button_hover.bind(node))
		node.pressed.connect(play_sfx.bind("ui_select"))


# Focus also moves when a screen grabs it at start: only beep on navigation
func _on_button_focus() -> void:
	for action in ["ui_up", "ui_down", "ui_left", "ui_right", "ui_focus_next", "ui_focus_prev"]:
		if Input.is_action_pressed(action):
			play_sfx("ui_move")
			return


func _on_button_hover(button: BaseButton) -> void:
	if !button.disabled and !button.has_focus():
		play_sfx("ui_move")
